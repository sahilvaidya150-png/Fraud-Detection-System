FRAUD_PROJECT_ROOT=.
FRAUD_MODEL_PATH=models/production/fraud_pipeline.joblib
FRAUD_METRICS_PATH=artifacts/metrics/model_metrics.json
FRAUD_DATASET_PATH=data/processed/fraud_sampled.csv
FRAUD_DATABASE_PATH=artifacts/predictions.sqlite
FRAUD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRAUD_AUTH_USERNAME=analyst
# Leave the password unset for a one-time local development credential printed at backend startup.
# Set this to a private value to use your own login.
# FRAUD_AUTH_PASSWORD=
# Set a private signing secret to preserve sessions across backend restarts.
# FRAUD_AUTH_SECRET=
FRAUD_AUTH_COOKIE_SECURE=false